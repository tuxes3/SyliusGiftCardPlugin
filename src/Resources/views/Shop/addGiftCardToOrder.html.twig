{% form_theme form '@SyliusShop/form/theme.html.twig' %}

<div class="setono-sylius-gift-card-gift-card-block mb-4">
    <div class="p-4 bg-light">
        {{ form_start(form, {
            'action': path('setono_sylius_gift_card_shop_partial_add_gift_card_to_order'),
            'attr': {
                'id': 'setono-sylius-gift-card-add-gift-card-to-order',
                'novalidate': 'novalidate',
                'data-action': path('setono_sylius_gift_card_shop_ajax_add_gift_card_to_order'),
                'data-redirect': path('sylius_shop_cart_summary')
            }
        }) }}
        {{ form_row(form._token) }}
        {{ form_end(form, {'render_rest': false}) }}

        <div class="input-group field" {{ sylius_test_html_attribute('cart-gift-card') }}>
            {{ form_widget(form.giftCard, sylius_test_form_attribute('cart-gift-card-input')|sylius_merge_recursive({'attr': {'form': 'setono-sylius-gift-card-add-gift-card-to-order'}})) }}
            <button type="submit" class="btn btn-outline-gray" form="setono-sylius-gift-card-add-gift-card-to-order" {{ sylius_test_html_attribute('apply-gift-card-button') }}>
                {{ 'setono_sylius_gift_card.ui.add_gift_card_to_order'|trans }}
            </button>
            {{ form_errors(form.giftCard) }}
        </div>
    </div>
</div>
