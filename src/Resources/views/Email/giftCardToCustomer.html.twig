{# @var \Sylius\Component\Core\Model\CustomerInterface customer #}
{# @var \Setono\SyliusGiftCardPlugin\Model\GiftCardInterface giftCard #}
{% extends '@SyliusCore/Email/layout.html.twig' %}

{% block subject %}{{ 'setono_sylius_gift_card.email.new_gift_card'|trans({}, null, localeCode) }}{% endblock %}

{% block content %}
    <div style="text-align: center; margin-bottom: 30px;">
        <p>{{ 'setono_sylius_gift_card.email.new_gift_card_intro'|trans({}, null, localeCode) }}</p>

        <strong>{{ giftCard.code }}</strong> ({{ 'setono_sylius_gift_card.email.balance'|trans({}, null, localeCode) }}: {{ giftCard.amount|sylius_format_money(giftCard.currencyCode, localeCode) }})
    </div>
{% endblock %}
