{# @var \Setono\SyliusGiftCardPlugin\Model\GiftCardInterface[] giftCards #}
{% extends '@SyliusCore/Email/layout.html.twig' %}

{% block subject %}{{ 'setono_sylius_gift_card.email.your_gift_card'|trans({}, null, localeCode) }}{% endblock %}

{% block content %}
    <div style="text-align: center; margin-bottom: 30px;">
        <p>{{ 'setono_sylius_gift_card.email.your_gift_cards_you_bought_in_the_order'|trans({}, null, localeCode) ~ ' ' ~ order.number }}:</p>

        {% for giftCard in giftCards %}
            <strong>{{ giftCard.code }}</strong> ({{ 'setono_sylius_gift_card.email.balance'|trans({}, null, localeCode) }}: {{ giftCard.amount|sylius_format_money(giftCard.currencyCode, localeCode) }})<br>
        {% endfor %}
    </div>
{% endblock %}
