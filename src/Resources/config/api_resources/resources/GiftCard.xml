<?xml version="1.0" encoding="UTF-8" ?>

<resources
    xmlns="https://api-platform.com/schema/metadata/resources-3.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="https://api-platform.com/schema/metadata/resources-3.0 https://api-platform.com/schema/metadata/resources-3.0.xsd"
>
    <resource class="%setono_sylius_gift_card.model.gift_card.class%" shortName="GiftCard">
        <operations>
            <operation
                name="setono_sylius_gift_card_admin_gift_card_get_collection"
                class="ApiPlatform\Metadata\GetCollection"
                uriTemplate="/admin/gift-cards"
            >
                <normalizationContext>
                    <values>
                        <value name="groups">
                            <values>
                                <value>admin:gift_card:read</value>
                            </values>
                        </value>
                    </values>
                </normalizationContext>
            </operation>

            <operation
                name="setono_sylius_gift_card_admin_gift_card_post"
                class="ApiPlatform\Metadata\Post"
                uriTemplate="/admin/gift-cards"
                processor="setono_sylius_gift_card.api.state_processor.gift_card.persist"
            >
                <denormalizationContext>
                    <values>
                        <value name="groups">
                            <values>
                                <value>admin:gift_card:create</value>
                            </values>
                        </value>
                    </values>
                </denormalizationContext>
                <normalizationContext>
                    <values>
                        <value name="groups">
                            <values>
                                <value>admin:gift_card:read</value>
                            </values>
                        </value>
                    </values>
                </normalizationContext>
                <validationContext>
                    <values>
                        <value name="groups">
                            <values>
                                <value>sylius</value>
                            </values>
                        </value>
                    </values>
                </validationContext>
            </operation>

            <operation
                name="setono_sylius_gift_card_admin_gift_card_get_balance"
                class="ApiPlatform\Metadata\GetCollection"
                uriTemplate="/admin/gift-cards/balance"
                provider="setono_sylius_gift_card.api.state_provider.gift_card_balance"
                paginationEnabled="false"
                output="Setono\SyliusGiftCardPlugin\Model\GiftCardBalanceCollection"
            >
                <openapi summary="Get the gift cards balance."/>
                <normalizationContext>
                    <values>
                        <value name="groups">
                            <values>
                                <value>admin:gift_card_balance:read</value>
                            </values>
                        </value>
                    </values>
                </normalizationContext>
            </operation>

            <operation
                name="setono_sylius_gift_card_admin_gift_card_get"
                class="ApiPlatform\Metadata\Get"
                uriTemplate="/admin/gift-cards/{code}"
            >
                <uriVariables>
                    <uriVariable parameterName="code" fromClass="%setono_sylius_gift_card.model.gift_card.class%"/>
                </uriVariables>
                <normalizationContext>
                    <values>
                        <value name="groups">
                            <values>
                                <value>admin:gift_card:read</value>
                            </values>
                        </value>
                    </values>
                </normalizationContext>
            </operation>

            <operation
                name="setono_sylius_gift_card_admin_gift_card_resend_email"
                class="ApiPlatform\Metadata\Get"
                uriTemplate="/admin/gift-cards/{code}/resend-email"
                controller="setono_sylius_gift_card_plugin.api.resend_gift_card_email"
            >
                <uriVariables>
                    <uriVariable parameterName="code" fromClass="%setono_sylius_gift_card.model.gift_card.class%"/>
                </uriVariables>
                <openapi summary="Resend the gift card email to the customer."/>
            </operation>

            <operation
                name="setono_sylius_gift_card_admin_gift_card_download_pdf"
                class="ApiPlatform\Metadata\Get"
                uriTemplate="/admin/gift-cards/{code}/pdf"
                controller="setono_sylius_gift_card_plugin.api.download_gift_card_pdf"
            >
                <uriVariables>
                    <uriVariable parameterName="code" fromClass="%setono_sylius_gift_card.model.gift_card.class%"/>
                </uriVariables>
                <openapi summary="Download the gift card as a PDF."/>
            </operation>

            <operation
                name="setono_sylius_gift_card_admin_gift_card_put"
                class="ApiPlatform\Metadata\Put"
                uriTemplate="/admin/gift-cards/{code}"
            >
                <uriVariables>
                    <uriVariable parameterName="code" fromClass="%setono_sylius_gift_card.model.gift_card.class%"/>
                </uriVariables>
                <denormalizationContext>
                    <values>
                        <value name="groups">
                            <values>
                                <value>admin:gift_card:update</value>
                            </values>
                        </value>
                    </values>
                </denormalizationContext>
                <normalizationContext>
                    <values>
                        <value name="groups">
                            <values>
                                <value>admin:gift_card:read</value>
                            </values>
                        </value>
                    </values>
                </normalizationContext>
                <validationContext>
                    <values>
                        <value name="groups">
                            <values>
                                <value>sylius</value>
                            </values>
                        </value>
                    </values>
                </validationContext>
            </operation>

            <operation
                name="setono_sylius_gift_card_admin_gift_card_delete"
                class="ApiPlatform\Metadata\Delete"
                uriTemplate="/admin/gift-cards/{code}"
            >
                <uriVariables>
                    <uriVariable parameterName="code" fromClass="%setono_sylius_gift_card.model.gift_card.class%"/>
                </uriVariables>
            </operation>

            <operation
                name="setono_sylius_gift_card_shop_gift_card_get_collection"
                class="ApiPlatform\Metadata\GetCollection"
                uriTemplate="/shop/gift-cards"
            >
                <openapi summary="Retrieves the collection of GiftCard resources associated to the logged in customer."/>
                <normalizationContext>
                    <values>
                        <value name="groups">
                            <values>
                                <value>shop:gift_card:read</value>
                            </values>
                        </value>
                    </values>
                </normalizationContext>
            </operation>

            <operation
                name="setono_sylius_gift_card_shop_gift_card_get"
                class="ApiPlatform\Metadata\Get"
                uriTemplate="/shop/gift-cards/{code}"
            >
                <uriVariables>
                    <uriVariable parameterName="code" fromClass="%setono_sylius_gift_card.model.gift_card.class%"/>
                </uriVariables>
                <openapi summary="Use $code to retrieve a gift card resource. You can use this to 'search' for gift cards."/>
                <normalizationContext>
                    <values>
                        <value name="groups">
                            <values>
                                <value>shop:gift_card:read</value>
                            </values>
                        </value>
                    </values>
                </normalizationContext>
            </operation>

            <operation
                name="setono_sylius_gift_card_shop_gift_card_download_pdf"
                class="ApiPlatform\Metadata\Get"
                uriTemplate="/shop/gift-cards/{code}/pdf"
                controller="setono_sylius_gift_card_plugin.api.download_gift_card_pdf"
            >
                <uriVariables>
                    <uriVariable parameterName="code" fromClass="%setono_sylius_gift_card.model.gift_card.class%"/>
                </uriVariables>
                <openapi summary="Download the gift card as a PDF."/>
            </operation>

            <operation
                name="setono_sylius_gift_card_shop_gift_card_add_to_order"
                class="ApiPlatform\Metadata\Patch"
                uriTemplate="/shop/gift-cards/{code}/add-to-order"
                messenger="input"
                input="Setono\SyliusGiftCardPlugin\Api\Command\AddGiftCardToOrder"
            >
                <uriVariables>
                    <uriVariable parameterName="code" fromClass="%setono_sylius_gift_card.model.gift_card.class%"/>
                </uriVariables>
                <openapi summary="Apply a gift card to your order."/>
                <denormalizationContext>
                    <values>
                        <value name="groups">
                            <values>
                                <value>shop:gift_card:add_to_order</value>
                            </values>
                        </value>
                    </values>
                </denormalizationContext>
                <normalizationContext>
                    <values>
                        <value name="groups">
                            <values>
                                <value>shop:gift_card:read</value>
                            </values>
                        </value>
                    </values>
                </normalizationContext>
                <validationContext>
                    <values>
                        <value name="groups">
                            <values>
                                <value>sylius</value>
                            </values>
                        </value>
                    </values>
                </validationContext>
            </operation>

            <operation
                name="setono_sylius_gift_card_shop_gift_card_remove_from_order"
                class="ApiPlatform\Metadata\Patch"
                uriTemplate="/shop/gift-cards/{code}/remove-from-order"
                messenger="input"
                input="Setono\SyliusGiftCardPlugin\Api\Command\RemoveGiftCardFromOrder"
            >
                <uriVariables>
                    <uriVariable parameterName="code" fromClass="%setono_sylius_gift_card.model.gift_card.class%"/>
                </uriVariables>
                <openapi summary="Remove a gift card from your order."/>
                <denormalizationContext>
                    <values>
                        <value name="groups">
                            <values>
                                <value>shop:gift_card:remove_from_order</value>
                            </values>
                        </value>
                    </values>
                </denormalizationContext>
                <normalizationContext>
                    <values>
                        <value name="groups">
                            <values>
                                <value>shop:gift_card:read</value>
                            </values>
                        </value>
                    </values>
                </normalizationContext>
                <validationContext>
                    <values>
                        <value name="groups">
                            <values>
                                <value>sylius</value>
                            </values>
                        </value>
                    </values>
                </validationContext>
            </operation>
        </operations>
    </resource>
</resources>
